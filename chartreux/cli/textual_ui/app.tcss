$chartreux_copper: #B87333;

* {
    scrollbar-size: 1 1;
}

*:ansi {
    link-color-hover: $ansi-background;
}

Screen {
    background: transparent;
}

Horizontal {
    width: 100%;
    height: auto;
}

TextArea > .text-area--cursor {
    color: $foreground;
}

#chat {
    layout: stream;
    height: 1fr;
    width: 100%;
    background: transparent;
    padding: 0;
    align-vertical: bottom;
}

#loading-area {
    height: auto;
    width: 100%;
    background: transparent;
    padding: 1 0 0 0;
    layout: horizontal;
    align: left middle;
}

#loading-area-content {
    width: 1fr;
    height: auto;
    align: left middle;
}

#inline-notice {
    width: auto;
    height: 1;
    color: $text-muted;
}

#inline-notice.-warning {
    color: $warning;
}

#inline-notice.-error {
    color: $error;
}

#bottom-app-container,
#input-container {
    height: auto;
    width: 100%;
    background: transparent;
}

#bottom-pending-action {
    height: 1;
    width: 100%;
    color: $warning;
    background: $surface;
    text-overflow: ellipsis;
}

.queue-header-message {
    margin-top: 1;
    margin-bottom: 0;
    width: 100%;
    height: auto;
}

.queue-header-container {
    width: 100%;
    height: auto;
}

.queue-header-content {
    width: auto;
    height: auto;
    text-style: none;
    color: $text-muted;
}

.queue-header-separator {
    width: 100%;
    height: 1;
    color: $text-muted;

}

#bottom-bar {
    height: auto;
    width: 100%;
    background: transparent;
    padding: 0;
    align: left middle;
    layout: horizontal;
}

#messages {
    layout: stream;
    width: 100%;
    height: auto;
    text-align: left;
    margin-top: 1;
    margin-bottom: 0;
}

#input-container {
    padding: 0;
    margin: 0;
}

#completion-popup {
    display: none;
    width: auto;
    max-width: 92;
    height: auto;
    color: $foreground;
    background: $surface;
    border: solid $foreground-muted;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    /* max-height and padding set in completion_popup.py */
}

OptionList, OptionList:focus {
    background: $background;
    background-tint: transparent;
}

#completion-popup _CompletionRow {
    height: 1;
    width: 1fr;
    text-wrap: nowrap;
}

#completion-popup _CompletionItem {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#completion-popup .completion-command {
    /* width set per-row in completion_popup.py, capped to 30% of the popup */
    max-width: 30%;
    margin-right: 2;
    text-style: bold;
}

#completion-popup .completion-description {
    width: 1fr;
    color: $text-muted;
}

#completion-popup.completion-no-description .completion-command {
    max-width: 100%;
    width: 1fr;
    margin-right: 0;
}

#completion-popup.completion-no-description .completion-description {
    display: none;
}

#completion-popup _CompletionRow.completion-selected {
    height: auto;
    text-style: bold reverse;
}

#completion-popup _CompletionRow.completion-selected _CompletionItem {
    background: transparent;
    color: $foreground;
    text-style: bold reverse;
}

#completion-popup _CompletionRow.completion-selected .completion-description {
    height: auto;
    text-wrap: wrap;
    text-overflow: clip;
}

#input-box {
    height: auto;
    width: 100%;
    background: transparent;
    border: none;
    border-top: solid $foreground-muted;
    border-bottom: solid $foreground-muted;
    border-title-align: right;
    border-title-color: $text-muted;

    &:focus-within {
        border-top: solid $primary;
        border-bottom: solid $primary;
    }

    &.border-warning {
        border-top: solid $warning;
        border-bottom: solid $warning;
        border-title-color: $warning;
    }

    &.border-safe {
        border-top: solid $foreground;
        border-bottom: solid $foreground;
        border-title-color: $foreground;
    }

    &.border-error {
        border-top: solid $error;
        border-bottom: solid $error;
        border-title-color: $error;
    }

    &.border-recording {
        border-top: solid $primary;
        border-bottom: solid $primary;
        border-title-color: $primary;
    }
}

#queue-mode-footer {
    height: 1;
    color: $text-muted;
}

#input-body {
    height: auto;
}

.input-body-layout {
    width: 100%;
    height: auto;
}

#prompt,
#prompt-spinner,
.recording-indicator {
    width: auto;
    background: transparent;
    color: $foreground;
    text-style: bold;
    padding: 0 1 0 0;
}

#input {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 4;
    background: transparent;
    color: $foreground;
    border: none;
    padding: 0;
    scrollbar-visibility: hidden;

    &.recording {
        color: $text-muted;
    }

    & .text-area--suggestion {
        color: $foreground;
        text-opacity: 45%;
    }

    &:ansi .text-area--suggestion {
        text-style: dim;
    }
}

ToastRack {
    align: left bottom;
    padding: 0;
    margin: 0 0 6 0;
}

Markdown {
    color: $foreground;

    .code_inline {
        color: $success;
        background: transparent;
        text-style: bold;
    }

    MarkdownFence {
        overflow-x: auto;
        scrollbar-size-horizontal: 1;
        max-width: 95%;
        background: transparent;

        & > Label {
            padding: 0;
        }
    }

    MarkdownTable {
        background: transparent;
    }

    MarkdownBlockQuote {
        background: transparent;
        border-left: outer $foreground-muted;
    }

    MarkdownBullet,
    MarkdownBulletList,
    MarkdownOrderedList {
        color: $foreground;
    }
}

.user-message {
    margin-top: 1;
    width: 100%;
    height: auto;

    &.pending {
        margin-top: 0;
        .user-message-separator {
            display: none;
        }
        .user-message-wrapper {
            margin-top: 0;
        }
    }

    &.no-separator .user-message-separator {
        display: none;
    }

    &.follows-user {
        margin-top: 0;

        .user-message-wrapper {
            margin-top: 0;
        }
    }
}

.user-message-wrapper {
    width: 100%;
    height: auto;
    padding-left: 2;
    background: $accent 8%;
}

.user-message.plain-user-accent {
    .user-message-wrapper {
        background: transparent;
    }
    .user-message-prompt {
        color: $foreground;
        text-style: none;
    }
}

.user-message-container {
    width: 100%;
    height: auto;
}

.user-message-row {
    width: 100%;
    height: auto;
}

.user-message-attachments {
    width: 100%;
    height: auto;
    padding: 0 2 0 0;
    color: $text-muted;

}

.user-message-attachment-line {
    width: 100%;
    height: auto;
}

.user-message-attachment-label {
    width: auto;
    height: auto;
}

.user-message-attachment-link {
    width: auto;
    height: auto;
}

.user-message-prompt {
    width: 2;
    height: 1;
    color: $accent;
    text-style: none;
}

.user-message-content {
    width: 1fr;
    height: auto;
    text-style: none;
}

.slash-command-message .user-message-content {
    color: $foreground;
}

.assistant-message-label {
    color: $foreground;
    text-style: bold;
    height: 1;
}

.user-message-separator {
    width: 100%;
    height: 1;
    color: $text-muted;
}

.assistant-message {
    layout: stream;
    margin-top: 1;
    width: 100%;
    height: auto;
    padding: 0;

    Markdown {
        width: 100%;
        height: auto;
        padding: 0;
        margin: 0;

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }
    }
}

.reasoning-message {
    margin-top: 1;
    width: 100%;
    height: auto;
}

.reasoning-message-wrapper {
    width: 100%;
    height: auto;
}

.reasoning-message-header {
    width: 100%;
    height: auto;
    pointer: pointer;
}

.reasoning-message-header:focus,
.collapsible-toggle:focus,
.tool-group-header:focus,
.tool-call-header:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

.reasoning-message-header:focus .reasoning-collapsed-text,
.collapsible-toggle:focus .status-indicator-text,
.collapsible-toggle:focus .collapsible-header-verb,
.collapsible-toggle:focus .collapsible-toggle-label,
.tool-group-header:focus .status-indicator-text,
.tool-call-header:focus .status-indicator-text {
    color: $background;
    text-opacity: 100%;
    text-style: bold;
}

.reasoning-indicator {
    width: auto;
    height: auto;
    color: $text-muted;
    margin-right: 1;

}

.reasoning-collapsed-text {
    width: auto;
    height: auto;
    color: $text-muted;
    text-style: none;

    &:ansi {
        text-style: none;
    }
}

.reasoning-message-content {
    layout: stream;
    width: 100%;
    height: auto;
    padding: 0 2 0 2;
    margin: 0;
    color: $text-muted;
    text-style: none;

    * {
        color: $text-muted;
        text-style: none;
    }

    & > MarkdownBlock:last-child {
        margin-bottom: 0;
    }
}

.interrupt-message,
.error-message,
.warning-message,
.user-command-message {
    margin-top: 0;
    margin-bottom: 0;
    height: auto;
    width: 100%;
}

.plan-file-message {
    margin-top: 1;
    margin-bottom: 0;
    height: auto;
    width: 100%;

    .plan-file-wrapper {
        height: auto;
        width: 100%;
        border: solid $foreground-muted;
        padding: 0 1;
    }

    Markdown {
        width: 100%;
        height: auto;
        padding: 0;
        margin: 0;

        & > MarkdownBlock:first-child {
            margin: 0 0 1 0;
        }

        & > MarkdownBlock:last-child {
            margin: 1 0 0 0;
        }
    }
}

.interrupt-container,
.error-container,
.warning-container,
.user-command-container {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

.interrupt-border,
.error-border,
.warning-border,
.user-command-border {
    width: auto;
    height: 100%;
    padding: 0 1 0 2;
}

.interrupt-content {
    width: 1fr;
    height: auto;
    margin: 0;
    padding-right: 2;
    color: $warning;
}

.error-content {
    width: 1fr;
    height: auto;
    margin: 0;
    padding-right: 2;
    color: $error;
    text-style: bold;
}

.warning-content {
    width: 1fr;
    height: auto;
    margin: 0;
    padding-right: 2;
    color: $warning;
}

.user-command-content {
    width: 1fr;
    height: auto;
    margin: 0;
    padding-right: 2;

    Markdown {
        margin: 0;
        padding: 0;

        & > MarkdownBlock:first-child {
            margin-top: 0;
        }

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }
    }
}

.collapsible-section {
    width: 1fr;
    height: auto;
}

/* Overflow toggle (OverflowCollapsibleSection): a small "+N lines"/"show less"
   disclosure beneath the body -- shrinks to its content. */
.collapsible-toggle {
    width: auto;
    height: auto;
    margin-top: 0;
    pointer: pointer;
}

/* Header toggle (HeaderCollapsibleSection): a summary line on top. It fills the
   width so messages without suffixes ellipsis when collapsed and wrap when
   expanded; the triangle and verb stay fixed-width on the first line. */
.collapsible-toggle.header {
    width: 1fr;
}

.collapsible-toggle.header .status-indicator-text {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.collapsible-toggle.header.has-suffix .status-indicator-text {
    width: auto;
}

.collapsible-toggle.header.expanded .status-indicator-text {
    text-wrap: wrap;
    text-overflow: clip;
    text-opacity: 100%;

    /* Restore full contrast on expand (see the dim rule below). */
    &:ansi {
        text-style: none;
    }
}

/* Folded summaries retain full contrast; severity and focus must stay legible. */
.collapsible-toggle.header .status-indicator-text {
    text-opacity: 100%;
}

.collapsible-toggle.header .collapsible-header-verb {
    text-opacity: 100%;
    text-style: bold;
}

.collapsible-toggle.header.expanded .collapsible-header-verb {
    text-opacity: 100%;

    &:ansi {
        text-style: bold;
    }
}

.collapsible-triangle {
    width: auto;
    height: auto;
    color: $text-muted;
    margin-right: 1;

    &.success {
        color: $success;

        &:ansi {
            text-style: none;
        }
    }

    &.error {
        color: $error;

        &:ansi {
            text-style: none;
        }
    }
}

.collapsible-header-verb {
    width: auto;
    height: auto;
    margin-right: 1;
    text-style: none;
    color: $foreground;
}

.collapsible-toggle-label {
    width: auto;
    height: auto;
    color: $text-muted;

}

StatusMessage {
    width: 100%;
    height: auto;

    Horizontal {
        width: 100%;
        height: auto;
    }
}

.status-indicator-icon {
    width: auto;
    height: auto;
    color: $primary;
    margin-right: 1;

    &.success {
        color: $success;
    }

    &.error {
        color: $error;
    }

    &.muted {
        color: $text-muted;
    }
}

.status-indicator-text {
    width: auto;
    height: auto;
    color: $foreground;
}

.status-indicator-suffix {
    width: auto;
    height: auto;
    margin-left: 1;
    color: $text-muted;

}

.compact-message,
.reload-config-message,
.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.rewind-fork-message {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 0;
}

.rewind-fork-message .status-indicator-text {
    width: auto;
    max-width: 100%;
    text-wrap: wrap;
}

.branch-created-message {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 0;
}

.branch-created-message .status-indicator-text {
    width: auto;
    max-width: 100%;
    text-wrap: wrap;
}

.tool-group {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.tool-group-header {
    width: 100%;
    height: auto;
    background: $background;
    padding: 0 1;
}

.tool-group-header .status-indicator-text {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    text-opacity: 100%;
}

.tool-group-body {
    width: 100%;
    height: auto;
}

.tool-group-content {
    width: 1fr;
    height: auto;
    margin-top: 0;
    border-left: tall $foreground-muted;
    padding-left: 1;
}

/* Group headers use the PulseSpinner's blinking square while running, then
   retain the usual success/error/muted indicator colors on their disclosure
   triangle once settled. */
.tool-group-header .status-indicator-icon.success,
.tool-group-header .status-indicator-icon.error,
.tool-group-header .status-indicator-icon.muted {
    text-style: bold;
}

.tool-call-label {
    width: auto;
    height: auto;
    margin-right: 1;
    color: $text-muted;
}

.tool-call-header .status-indicator-text {
    /* 1fr (not auto) gives a definite width so long text wraps to the
       available space instead of measuring unwrapped and overflowing. */
    width: 1fr;
    text-wrap: wrap;
}

/* With a suffix (e.g. "(scratchpad)") the title takes its content width so the
   suffix sits directly after it instead of being pushed to the right edge by a
   1fr title that fills the row. */
.tool-call-header.has-suffix .status-indicator-text {
    width: auto;
    text-wrap: nowrap;
}

.tool-call-header.running.collapsible-result .status-indicator-text,
.tool-call-header.running.collapsible-result .collapsible-header-verb {
    text-opacity: 100%;
}

/* Timing rows reserve trailing metadata before eliding target/detail text. */
.tool-call-header.has-timing .status-indicator-text,
.collapsible-toggle.header.has-timing .status-indicator-text {
    width: 1fr;
    min-width: 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.collapsible-toggle.header.has-timing.expanded .status-indicator-text {
    text-wrap: wrap;
    text-overflow: fold;
}

.tool-group.timing-enabled > .tool-group-body > .tool-group-content {
    border-left: none;
    padding-left: 0;
}

/* Focus styling wins over folded/resting color rules. */
.collapsible-toggle:focus .status-indicator-text,
.collapsible-toggle:focus .collapsible-header-verb,
.tool-group-header:focus .status-indicator-text,
.tool-call-header:focus .status-indicator-text,
.tool-call-header:focus .collapsible-header-verb {
    color: $background;
    text-opacity: 100%;
    text-style: bold;
}

/* Children of a group are packed with no vertical gaps between them. */
.tool-group > .tool-call,
.tool-group > .tool-result,
.tool-group > .reasoning-message {
    margin-top: 0;
}

.tool-call-container {
    width: 100%;
    height: auto;
}

.tool-stream-message {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 0 2 0 2;

}

.tool-result {
    width: 100%;
    height: auto;
    margin-top: 0;
    margin-left: 0;
    padding: 0;
    background: transparent;
    color: $foreground;

    &.has-gap {
        margin-top: 1;
    }

    &.error-text {
        color: $error;
    }

    &.warning-text {
        color: $warning;
    }
}

.tool-result-container {
    width: 100%;
    height: auto;
    margin-top: 0;
    padding: 0;
}

.tool-result-border {
    width: auto;
    height: 100%;
    padding: 0 1 0 2;
    color: $text-muted;

}

.tool-result-content {
    width: 1fr;
    height: auto;
    padding-right: 2;
}

.tool-call-widget,
.tool-result-widget {
    width: 100%;
    height: auto;
    color: $foreground;
}

.tool-result-widget Static {
    height: auto;
}

.tool-result-widget Markdown {
    padding: 0;
    margin: 0;
}

.tool-result-widget Markdown > * {
    margin-top: 0;
    margin-bottom: 0;
}

.tool-result-widget Markdown MarkdownFence {
    margin: 0;
    padding: 0;
    /* Override the 95% cap on plain-message fences: tool-result bodies should
       fill the width up to the content container's right padding. */
    max-width: 100%;
}

.tool-call-detail {
    height: auto;
    color: $text-muted;
}

.tool-result-detail {
    height: auto;
    color: $foreground;
    margin-top: 0;
}

.tool-result-error {
    color: $error;
}

.tool-result-warning {
    color: $warning;
}

.virtual-output-body,
.virtual-output-scroll {
    width: 1fr;
    height: auto;
}

.virtual-output-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 1;
}

.virtual-output-scroll .virtual-output-text {
    width: auto;
    min-width: 100%;
    height: auto;
    text-wrap: nowrap;
}

.copy-full-output {
    width: auto;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0;
    background: transparent;
    color: $text-muted;
}

.diff-scroll {
    width: 1fr;
    height: auto;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 1;

    .collapsible-section,
    VerticalGroup {
        width: auto;
    }
}

/* The whole diff renders as one DiffView. It must stay nowrap and grow to its
   content width so wide lines scroll horizontally in .diff-scroll. The per-row
   band and gap color are painted in DiffView.render_line, not via CSS. */
.diff-scroll .diff-view {
    width: auto;
    min-width: 100%;
    height: auto;
    text-wrap: nowrap;
}

.todo-empty,
.todo-cancelled {
    height: auto;
    color: $text-muted;

}

.todo-pending {
    height: auto;
    color: $foreground;
}

.todo-in_progress {
    height: auto;
    color: $warning;
}

.todo-completed {
    height: auto;
    color: $success;
}

.loading-widget {
    width: 100%;
    height: auto;
    color: $text-muted;
}

.loading-container,
.loading-indicator,
.loading-status,
.loading-hint {
    width: auto;
    height: auto;
}

.loading-indicator {
    margin-right: 1;
    color: $primary;
}

.loading-status {
    color: $primary;
    width: auto;
    height: auto;
}

.loading-char {
    width: auto;
    height: auto;
}

.loading-hint {
    width: auto;
    height: auto;
    color: $text-muted;

}

.loading-debounce {
    width: auto;
    height: auto;
    margin-left: 1;
}

.history-load-more-message {
    width: 100%;
    height: auto;
    text-align: center;
    content-align: center middle;
    margin: 1 0;
}

.history-load-more-container {
    width: 100%;
    height: auto;
    content-align: center middle;
}

.history-load-more-button {
    background: transparent;
    border: none;
    color: $warning;
    text-style: bold;
    pointer: pointer;
    padding: 1;
}

.history-load-more-button:hover {

}

#mcp-app, #mcpoauth-app {
    width: 100%;
    height: auto;
    max-height: 50vh;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

.settings-title {
    height: auto;
    text-style: bold;
    color: $foreground;
}

.settings-help {
    height: auto;
    color: $text-muted;

}

#mcp-content, #mcpoauth-content {
    width: 100%;
    height: auto;
}

#mcp-options, #mcpoauth-options {
    width: 100%;
    max-height: 50vh;
    border: none;
}

#mcp-options:focus > .option-list--option-highlighted,
#mcpoauth-options:focus > .option-list--option-highlighted,
#modelpicker-options:focus > .option-list--option-highlighted,
#thinkingpicker-options:focus > .option-list--option-highlighted,
#loglevelpicker-options:focus > .option-list--option-highlighted,
#themepicker-options:focus > .option-list--option-highlighted,
#sessionpicker-options:focus > .option-list--option-highlighted {
    background: $foreground;
    color: $surface;
    text-style: bold;
}

#mcp-actions {
    height: 1;
    width: 100%;
}

#mcp-actions Button {
    height: 1;
    min-width: 0;
    margin-right: 2;
    border: none;
}

#mcp-app {
    height: 50vh;
}

#mcp-content {
    height: 1fr;
}

#mcp-options {
    height: 1fr;
}

#mcp-search-row {
    height: auto;
    width: 100%;
    background: transparent;
    padding-left: 1;
    margin-bottom: 1;
}

#mcp-search-icon {
    width: 7;
    height: 1;
    color: $text-muted;
    margin-right: 1;

}

#mcp-search {
    width: 1fr;
    height: auto;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
}

#mcp-search:focus {
    border: solid $primary;
}

#mcp-options:focus, #mcpoauth-options:focus {
    border: none;
}

#mcpoauth-detail {
    margin: 1 0;
}

#proxysetup-app {
    width: 100%;
    height: auto;
    max-height: 50vh;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#proxysetup-content {
    width: 100%;
    height: auto;
    max-height: 100%;
}

#proxysetup-form {
    width: 100%;
    height: auto;
    overflow-y: auto;
}

.proxy-field-error {
    width: 100%;
    height: 1;
    color: $error;
}

.proxy-label-line {
    height: auto;
}

.proxy-input {
    width: 100%;
    height: auto;
    border: solid $foreground-muted;
    padding: 0 1;
}


.proxy-input:focus {
    border: solid $primary;
}

.proxy-input.-invalid {
    border: solid $error;
}

#proxysetup-error {
    color: $error;
}

.proxy-actions {
    height: auto;
    width: 100%;
}

.proxy-actions Button,
#sessionpicker-delete Button {
    width: auto;
    min-width: 0;
    height: 1;
    background: $surface;
    border: none;
    color: $foreground;
    padding: 0 1;
    margin-right: 1;
}

.proxy-actions Button:focus,
#sessionpicker-delete Button:focus {
    text-style: bold reverse;
}

#proxysetup-discard,
#sessionpicker-confirm-delete {
    color: $error;
}

#proxysetup-discard-confirm {
    width: 100%;
    height: auto;
}

#proxysetup-discard-message {
    color: $warning;
    height: auto;
}

#sessionpicker-delete {
    height: auto;
    width: 100%;
}

#sessionpicker-delete NoMarkupStatic {
    height: auto;
    color: $warning;
}

.code-block {
    height: auto;
    color: $foreground;
    background: transparent;
    padding: 1;
}

#question-app {
    width: 100%;
    height: auto;
    max-height: 50vh;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#question-content {
    width: 100%;
    height: auto;
    max-height: 100%;
}

#question-body {
    width: 100%;
    height: auto;
    overflow-y: auto;
}

.question-tabs {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.question-title {
    height: auto;
    text-style: bold;
    color: $foreground;
    margin-bottom: 0;
}

.question-option {
    width: 100%;
    height: auto;
    color: $foreground;
}

.question-option-selected {
    color: $foreground;
    text-style: bold reverse;
}

.question-other-row {
    width: 100%;
    height: auto;
}

.question-other-prefix {
    width: auto;
    height: auto;
    color: $text-muted;
}

.question-other-input {
    width: 1fr;
    height: auto;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
}

.question-other-input:focus {
    border: solid $primary;
}

.question-other-static {
    width: auto;
    height: auto;
    color: $text-muted;

}

.question-submit {
    width: 100%;
    height: auto;
    color: $foreground;
    margin-top: 1;
}

.question-footer-note {
    height: auto;
    color: $text-muted;
    margin-top: 1;

}

.question-help {
    height: auto;
    color: $text-muted;
    margin-top: 1;

}

.question-help.submission-warning {
    color: $warning;
}

.question-help.submission-error {
    color: $error;
}

ExpandingBorder {
    width: auto;
    height: 100%;
    content-align: left bottom;
}

NarratorStatus {
    width: auto;
    height: auto;
    background: transparent;
    padding: 0;
    margin: 0;
}

#banner-container {
    align: left top;
    padding: 1 1 0 0;
    width: auto;
}

.banner-chat {
    /* Pinned so the parent never renders the braille grid just to size it.
       Braille output is a constant 3 rows (ceil(HEIGHT/4), HEIGHT=12) by
       11 cols (ceil(WIDTH/2), WIDTH=22); see petit_chat.py / braille_renderer.py. */
    width: 12;
    height: 3;
}

#banner-info {
    width: auto;
    height: auto;
    margin-top: 1;
    content-align: left top;
}

.banner-line {
    width: auto;
    height: 1;
}

#banner-brand {
    color: $chartreux_copper;
    text-style: bold;
    width: auto;
}

.banner-spacer {
    width: 1;
    color: transparent;
}

.banner-meta {
    color: $foreground;
    width: auto;
}

#banner-model {
    color: $foreground;
    width: auto;
}

#banner-user-plan {
    width: auto;
}

#banner-meta-counts {
    width: auto;
}

.banner-cmd {
    color: $foreground;
    width: auto;
}

.petit-chat {
    color: $foreground;
    width: 12;
    height: 3;
}

.whats-new-message {
    border-left: solid $foreground-muted;
    margin-bottom: 1;

    Markdown {
        padding: 0 0 0 1;
        margin: 0;

        & > MarkdownBlock:first-child {
            margin-top: 0;
        }

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }

        MarkdownBulletList,
        MarkdownOrderedList {
            margin-top: 1;
            margin-bottom: 1;
        }

        MarkdownH1 {
            content-align: left middle;
        }
    }
}

.whats-new-message.after-history {
    margin-top: 1;
}

.custom-tools-deprecation-message {
    border-left: solid $foreground-muted;
    margin-bottom: 1;

    Markdown {
        padding: 0 0 0 1;
        margin: 0;

        & > MarkdownBlock:first-child {
            margin-top: 0;
        }

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }
    }
}

#sessionpicker-app {
    width: 100%;
    height: auto;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#sessionpicker-content {
    width: 100%;
    height: auto;
}

#sessionpicker-options {
    width: 100%;
    max-height: 50vh;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
}

#sessionpicker-options:focus {
    border: none;
}

.sessionpicker-header {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#sessionpicker-loading {
    width: 100%;
    height: auto;
    color: $text-muted;
}

.sessionpicker-loading-indicator,
.sessionpicker-loading-status {
    width: auto;
    height: auto;
}

.sessionpicker-loading-indicator {
    margin-right: 1;
}

.sessionpicker-help {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-top: 1;

}


#sessionpicker-loading.-failed {
    color: $error;
}
/* Debug Console */

#debug-console {
    dock: right;
    width: 40;
    height: 100%;
    background: $surface;
    border-left: solid $foreground-muted;
    padding: 0 1;
}

#debug-console.-fullscreen {
    dock: none;
    position: absolute;
    width: 100vw;
    height: 100vh;
    offset: 0 0;
    background: $background;
    border: none;
    layer: overlay;
}

#debug-console-header {
    width: 100%;
    height: auto;
    color: $foreground;
    padding: 0 0 1 0;
    text-align: left;
    text-style: bold;
}

#debug-console-footer {
    height: 1;
    color: $text-muted;
}

#debug-console-log {
    width: 100%;
    height: 1fr;
    background: transparent;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#modelpicker-app {
    width: 100%;
    height: auto;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#modelpicker-content {
    width: 100%;
    height: auto;
}

.modelpicker-title {
    height: auto;
    text-style: bold;
    color: $foreground;
}

#modelpicker-options {
    width: 100%;
    max-height: 50vh;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
}

#modelpicker-options:focus {
    border: none;
}

.modelpicker-help {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-top: 1;

}

#thinkingpicker-app {
    width: 100%;
    height: auto;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#thinkingpicker-content {
    width: 100%;
    height: auto;
}

.thinkingpicker-title {
    height: auto;
    text-style: bold;
    color: $foreground;
}

#thinkingpicker-options {
    width: 100%;
    max-height: 50vh;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
}

#thinkingpicker-options:focus {
    border: none;
}

.thinkingpicker-help {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-top: 1;

}

#loglevelpicker-app {
    width: 100%;
    height: auto;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#loglevelpicker-content {
    width: 100%;
    height: auto;
}

.loglevelpicker-title {
    height: auto;
    text-style: bold;
    color: $foreground;
}

.loglevelpicker-subtitle {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;

}

#loglevelpicker-scopes {
    height: 1;
    width: 100%;
}

#loglevelpicker-scopes Button, #loglevelpicker-apply {
    width: auto;
    min-width: 0;
    height: 1;
    background: $surface;
    border: none;
    color: $foreground;
    padding: 0 1;
    margin-right: 1;
}

#loglevelpicker-scopes Button:focus, #loglevelpicker-apply:focus {
    text-style: bold reverse;
}

#loglevelpicker-options {
    width: 100%;
    max-height: 50vh;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
}

#loglevelpicker-options:focus {
    border: none;
}

.loglevelpicker-persist {
    width: 100%;
    height: auto;
    margin-top: 1;
}

#loglevelpicker-discard {
    width: 100%;
    height: auto;
}

#loglevelpicker-discard NoMarkupStatic {
    height: auto;
    color: $warning;
}

#loglevelpicker-discard Button {
    width: auto;
    min-width: 0;
    height: 1;
    background: $surface;
    border: none;
    color: $foreground;
    padding: 0 1;
    margin-right: 1;
}

#loglevelpicker-discard Button:focus {
    text-style: bold reverse;
}

#loglevelpicker-confirm-discard {
    color: $error;
}

.loglevelpicker-help {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-top: 1;

}

#themepicker-app {
    width: 100%;
    height: auto;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#themepicker-content {
    width: 100%;
    height: auto;
}

.themepicker-title {
    height: auto;
    text-style: bold;
    color: $foreground;
}

#themepicker-options {
    width: 100%;
    max-height: 50vh;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
}

#themepicker-options:focus {
    border: none;
}

.themepicker-help {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-top: 1;

}

.user-message.rewind-selected {
    .user-message-content {
        text-style: bold reverse;
    }
}

.user-message.queue-selected {
    .user-message-content {
        text-style: bold reverse;
    }
}

#rewind-app {
    width: 100%;
    height: auto;
    background: $surface;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#rewind-content {
    width: 100%;
    height: auto;
}

.rewind-title {
    height: auto;
    text-style: bold;
    color: $foreground;
}

.rewind-option {
    width: 100%;
    height: auto;
    color: $foreground;
}

.rewind-cursor-selected {
    color: $foreground;
    text-style: bold reverse;
}

.rewind-option-unselected {
    color: $foreground;
}

.rewind-help {
    height: auto;
    color: $text-muted;

}

/* Limit the complete task surface, including borders, titles and help, to half
   the terminal height; the list/body scrolls within the remaining space. */
#sessionpicker-app, #modelpicker-app, #thinkingpicker-app,
#loglevelpicker-app, #themepicker-app, #rewind-app {
    max-height: 50vh;
}

#sessionpicker-content, #modelpicker-content, #thinkingpicker-content,
#loglevelpicker-content, #themepicker-content, #rewind-content,
#mcp-content, #mcpoauth-content {
    max-height: 100%;
    overflow-y: auto;
}

#sessionpicker-options, #modelpicker-options, #thinkingpicker-options,
#loglevelpicker-options, #themepicker-options, #mcp-options,
#mcpoauth-options {
    max-height: 7;
}

/* Textual's default block-cursor fill must not sit beneath reverse video. */
#mcp-options, #mcpoauth-options, #modelpicker-options,
#thinkingpicker-options, #loglevelpicker-options,
#themepicker-options, #sessionpicker-options {
    & > .option-list--option-highlighted {
        background: transparent;
        color: $foreground;
        text-style: none;
    }
    &:focus > .option-list--option-highlighted {
        background: $foreground;
        color: $surface;
        text-style: bold;
    }
}

#mcp-options:ansi:focus > .option-list--option-highlighted,
#mcpoauth-options:ansi:focus > .option-list--option-highlighted,
#modelpicker-options:ansi:focus > .option-list--option-highlighted,
#thinkingpicker-options:ansi:focus > .option-list--option-highlighted,
#loglevelpicker-options:ansi:focus > .option-list--option-highlighted,
#themepicker-options:ansi:focus > .option-list--option-highlighted,
#sessionpicker-options:ansi:focus > .option-list--option-highlighted {
    background: $ansi-foreground;
    color: $ansi-background;
    text-style: bold;
}

.question-option-selected, .rewind-cursor-selected {
    background: $foreground;
    color: $surface;
    text-style: bold;
}

.hook-system-message {
    height: auto;
    width: 100%;
    margin-top: 0;
    margin-bottom: 0;
}

.hook-run-container {
    height: auto;
    width: 100%;
}

.hook-pre-tool {
    margin-top: 1;
}

.hook-run-container:empty {
    display: none;
}

.hook-system-container {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

.hook-system-icon {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
}

.hook-system-content {
    width: 1fr;
    height: auto;
    max-height: 3;
    overflow: hidden;
    color: $text-muted;

}

.hook-severity-ok .hook-system-icon {
    color: $success;
}

.hook-severity-warning .hook-system-icon {
    color: $warning;
}

.hook-severity-error .hook-system-icon {
    color: $error;
}
