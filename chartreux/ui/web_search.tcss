#websearch-screen {
    align: center middle;
}

#websearch-content {
    width: 88;
    height: 36;
    max-height: 100%;
    background: $surface;
    border: solid $foreground-muted;
    border-title-color: $foreground;
    border-title-style: bold;
    padding: 0 1;
}

#websearch-content.fullscreen {
    width: 100%;
    height: 100%;
    background: $background;
    border: none;
}

#websearch-title {
    display: none;
    height: 1;
    text-style: bold;
}

#websearch-content.fullscreen #websearch-title {
    display: block;
}

#websearch-readiness {
    height: auto;
    min-height: 1;
    color: $text-muted;
    text-wrap: wrap;
}

#websearch-form {
    height: 1fr;
    scrollbar-gutter: stable;
}

.websearch-section {
    height: 1;
    text-style: bold;
    color: $foreground;
    margin-top: 1;
}

#websearch-providers {
    height: 5;
    border: none;
}

#websearch-providers:focus > .option-list--option-highlighted {
    color: $foreground;
    text-style: none;
    background: transparent;
}

#websearch-providers:blur > .option-list--option-highlighted {
    text-style: none;
    background: transparent;
}

#websearch-provider-note,
#websearch-current-provider,
#websearch-selected-env,
#websearch-key-result,
.websearch-field-help {
    height: auto;
    color: $text-muted;
    text-wrap: wrap;
}

#websearch-credential {
    height: auto;
}

#websearch-key-row {
    height: 3;
    width: 100%;
}

#websearch-key {
    width: 1fr;
}

#websearch-save-key {
    width: 18;
    min-width: 18;
    margin-left: 1;
}

#websearch-advanced {
    display: none;
    height: auto;
}

.websearch-field-label {
    height: 1;
    text-style: bold;
}

#websearch-advanced Input,
#websearch-key {
    height: 3;
    border: solid $foreground-muted;
    background: $surface;
}

#websearch-advanced Input:focus,
#websearch-key:focus {
    border: solid $primary;
}

#websearch-message {
    height: auto;
    color: $text-muted;
    text-wrap: wrap;
    border-top: solid $foreground-muted;
}

#websearch-actions,
.websearch-confirm-actions {
    height: 3;
    width: 100%;
}

#websearch-actions Button,
.websearch-confirm-actions Button {
    min-width: 0;
    margin-right: 1;
}

#websearch-confirmation {
    display: none;
    height: 1fr;
}

#websearch-confirmation-text {
    height: auto;
    text-wrap: wrap;
}

#websearch-help {
    height: 1;
    color: $text-muted;
}
